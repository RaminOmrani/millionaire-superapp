# Copy to .env and fill in. Never commit .env.

# SQLite file (mounted as a Docker volume in production)
DATABASE_PATH=./data/app.db

# Admin panel (phase 2) — single admin, credentials live here only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters, used to sign the iron-session cookie
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site origin (used for absolute URLs / metadata)
NEXT_PUBLIC_SITE_URL=https://app.softmiliac.com
