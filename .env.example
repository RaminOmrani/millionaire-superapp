# Copy to .env and fill in. Never commit .env.

# SQLite file (mounted as a Docker volume in production)
DATABASE_PATH=./data/app.db

# Admin panel (phase 2) — single admin, credentials live here only
# If a value contains $ or #, wrap it in single quotes: ADMIN_PASSWORD='p$ss#word'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters, used to sign the iron-session cookie
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Host port the app is published on when using docker-compose.external-proxy.yml
APP_PORT=3100

# Public site origin (used for absolute URLs / metadata)
NEXT_PUBLIC_SITE_URL=https://app.softmiliac.com

# Optional: e-mail notification for new consultation requests (leave unset to disable).
# The recipient address is set inside /admin → تنظیمات.
# SMTP_HOST=mail.softmiliac.com
# SMTP_PORT=587
# SMTP_USER=info@softmiliac.com
# SMTP_PASS=
# SMTP_FROM=info@softmiliac.com
